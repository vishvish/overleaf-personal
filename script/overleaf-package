#!/usr/bin/env python3
"""Build a shareable Overleaf ZIP from an explicit file allowlist."""

import argparse
import hashlib
from pathlib import Path
import re
import zipfile


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--image", help="Digest-pinned image; defaults to release.lock")
    parser.add_argument("--output", required=True, type=Path, help="Output ZIP path")
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    lock = dict(line.split("=", 1) for line in (root / "release.lock").read_text().splitlines() if "=" in line)
    args.image = args.image or lock["IMAGE"]
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9._/:-]*@sha256:[0-9a-f]{64}", args.image):
        parser.error("--image must contain a sha256 digest")
    template = root
    patch = (root / lock["PATCH"]).read_bytes()
    if hashlib.sha256(patch).hexdigest() != lock["PATCH_SHA256"]:
        parser.error("The Overleaf source patch does not match release.lock")

    files = {}
    names = ("README.md", "compose.yaml", "mongo-init.js", "images.env", "overleaf",
             "Start Overleaf.command", "Stop Overleaf.command", "LICENSE")
    for name in names:
        source = template / ("docs/BUNDLE-README.md" if name == "README.md" else name)
        if source.is_symlink() or not source.is_file():
            parser.error(f"Missing regular release file: {name}")
        executable = name == "overleaf" or name.endswith(".command")
        files[name] = (source.read_bytes(), 0o755 if executable else 0o644)
    files["image.txt"] = ((args.image + "\n").encode(), 0o644)
    files["texlive-full.patch"] = (patch, 0o644)
    source_notes = f"""# Source and build information

Upstream source: {lock['SOURCE_URL']}
Source revision: {lock['SOURCE_COMMIT']}
Local patch: texlive-full.patch
Patch SHA256: {lock['PATCH_SHA256']}
Release image: {args.image}

The upstream LICENSE is included. This is a community build using upstream's
server-ce Makefile with full TeX Live and Fontconfig registration enabled by
the included patch. No private projects, uploaded fonts or account data are
part of the image or this package.

To build from source (run in a new working directory with the patch alongside):

```sh
git clone {lock['SOURCE_URL']} source
git -C source checkout {lock['SOURCE_COMMIT']}
git -C source apply ../texlive-full.patch
arch=arm64 # use amd64 for Intel / AMD
DOCKER_DEFAULT_PLATFORM="linux/$arch" make -C source/server-ce \\
  OVERLEAF_BASE_TAG="overleaf-local-base:$arch" \\
  OVERLEAF_BASE_BRANCH="overleaf-local-base:$arch" \\
  OVERLEAF_TAG="overleaf-local:$arch" \\
  OVERLEAF_BRANCH="overleaf-local:$arch" build-base build-community
```

Building uses the current TeX Live mirror and OS package repositories.
The pinned release digest identifies the distributed binaries exactly.
"""
    files["SOURCE.md"] = (source_notes.encode(), 0o644)
    checksums = "".join(f"{hashlib.sha256(data).hexdigest()}  {name}\n"
                        for name, (data, _) in sorted(files.items()))
    files["SHA256SUMS"] = (checksums.encode(), 0o644)
    args.output = args.output.expanduser().resolve()
    if args.output.exists():
        parser.error("The output ZIP already exists; choose a new output path")
    args.output.parent.mkdir(parents=True, exist_ok=True)
    with args.output.open("xb") as destination:
        with zipfile.ZipFile(destination, "w", compression=zipfile.ZIP_DEFLATED) as archive:
            for name, (data, mode) in sorted(files.items()):
                info = zipfile.ZipInfo(f"overleaf-personal/{name}")
                info.create_system = 3
                info.external_attr = (0o100000 | mode) << 16
                info.compress_type = zipfile.ZIP_DEFLATED
                archive.writestr(info, data)
    print(args.output)
    print(f"SHA256 {hashlib.sha256(args.output.read_bytes()).hexdigest()}")


if __name__ == "__main__":
    main()
